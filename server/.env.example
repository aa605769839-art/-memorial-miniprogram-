# ============================================================
# 纪念小程序 后端环境变量模板（独立部署 / 非 Coze 平台）
# 复制为 .env 并按实际服务填写
# ============================================================

# ---- 服务端口（默认 3000）----
PORT=3000

# ---- Supabase（数据库），通用变量优先 ----
# 支持两种：通用 SUPABASE_URL / 兼容 COZE_SUPABASE_URL
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---- S3 兼容对象存储（上传图片/文件）----
BUCKET_ENDPOINT_URL=
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
BUCKET_NAME=
BUCKET_REGION=cn-beijing

# ---- AI 能力（可选，图片/文本生成，未配置时返回友好降级）----
# COZE_BUCKET_ACCESS_KEY=
# COZE_BUCKET_SECRET_KEY=