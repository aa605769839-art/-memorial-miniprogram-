# 纪念小程序独立部署环境变量
# 复制为 .env 使用

# ---- 对外端口（避让 tailplanet 的 80）----
WEB_PORT=18080

# ---- 前端访问路径前缀 ----
# 若希望与 tailplanet 共用 80 端口，由上层 nginx 按路径分流时使用前缀
MEMORIAL_PREFIX=/memorial

# ---- PostgreSQL ----
PG_DATABASE=memorial
PG_USER=memorial_app
PG_PASSWORD=memorial_pass_2024

# ---- 对象存储（S3 兼容：MinIO/COS/OSS）----
BUCKET_ENDPOINT_URL=
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
BUCKET_NAME=
BUCKET_REGION=cn-beijing