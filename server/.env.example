# ============================================================
# 纪念小程序 后端环境变量模板（独立部署 / 非 Coze 平台）
# 复制为 .env 并按实际服务填写
# ============================================================

# ---- 服务端口（默认 3000）----
PORT=3000

# ---- PostgreSQL 数据库（Drizzle 直连，独立实例）----
# 例如: postgres://memorial_app:密码@127.0.0.1:5432/memorial
DATABASE_URL=

# ---- S3 兼容对象存储（上传图片/文件，可选）
# 未配置时上传接口返回友好错误，应用正常启动
BUCKET_ENDPOINT_URL=
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
BUCKET_NAME=
BUCKET_REGION=cn-beijing

# ---- AI 文本润色（可选，OpenAI 兼容接口）----
# LLM_API_URL 如 https://api.openai.com/v1
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- AI 图像生成（可选，OpenAI 兼容 /chat/completions 的 images API）----
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_API_MODEL=dall-e-3